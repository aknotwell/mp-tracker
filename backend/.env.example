APP_ENV=development
APP_DEBUG=true
APP_API_PREFIX=/api/v1
APP_DATABASE_URL=sqlite+aiosqlite:///./mp_tracker.sqlite3
APP_FRONTEND_ORIGIN=http://localhost:3000

# Google OpenID Connect values come from a Google Cloud OAuth web client.
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Replace this with a long random value outside local development.
APP_JWT_SECRET=development-only-change-me-use-32-bytes
APP_JWT_ISSUER=mp-tracker-api
APP_JWT_AUDIENCE=mp-tracker-web
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_SESSION_DAYS=30
APP_REFRESH_COOKIE_NAME=mp_tracker_refresh
APP_CSRF_COOKIE_NAME=mp_tracker_csrf
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=lax

# Comma-separated, lowercase verified Google emails promoted to admin on login.
APP_ADMIN_EMAILS=
